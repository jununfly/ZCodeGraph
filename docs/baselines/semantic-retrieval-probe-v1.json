{
  "metric": "semantic-retrieval-probe",
  "version": 1,
  "status": "exploratory-ai-source-anchored",
  "consumer": "scripts/measure/semantic-retrieval-probe.mjs",
  "labelPolicy": {
    "scope": "AI-authored natural-language questions anchored to reviewed real source definitions; not independent human relevance judgments.",
    "oracle": "Hit@k = at least one expected entry file in the top k, with the files array as a set. Any-of matching is correct for multi-file flows, not per-file relevance recall.",
    "hardNegativePolicy": "Each query has at least two semantically related distractors. They are review targets, not asserted irrelevant labels: a returned distractor does not count as a hit or automatically as a defect.",
    "splitPolicy": "holdout is fixed before fusion tuning. Development cases cannot be used for final acceptance. The full independent release gate requires human-blind labels and at least four languages.",
    "limitations": [
      "The probe vector stores are small real-code corpora, not a claim of large-repository latency.",
      "Corpus vectors were generated from the first 8000 characters using BGE-small-en-v1.5; query and document processing must remain identical across compared arms.",
      "No response correctness, independent human labeling, or Agent Sufficiency result is implied by this input."
    ]
  },
