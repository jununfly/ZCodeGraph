{
  "schemaVersion": 1,
  "experimentId": "rust-indexing-core-phase-15f-borrowed-id-vscode-after",
  "kind": "indexing-ab",
  "arms": ["typescript", "rust"],
  "sourceCopy": {
    "mode": "js-ts-config-slice",
    "isolation": "per-arm"
  },
  "rust": {
    "graphWorkProfile": "matched-ts-js"
  },
  "targets": [
    {
      "name": "vscode",
      "pathEnv": "ZCODEGRAPH_CORPUS_VSCODE",
      "pathFallback": "/private/tmp/codegraph-corpus/vscode-sparse",
      "targetClass": "stress",
      "requiredForDecision": false,
      "requiredAfterPrdCompletion": true,
      "expectedCommit": "4ac5322601c6985aba4cd9349c23f4ef22dc3e65",
      "allowDirty": true,
      "sparsePatterns": [".github", "build", "extensions", "scripts", "src", "test"],
      "promptIds": ["VS-1"]
    }
  ],
  "metrics": {
    "thresholds": {
      "wallTimeImprovementPct": 25,
      "peakRssReductionPct": 30,
      "maxOtherMetricRegressionPct": 10
    }
  },
  "outputs": {
    "baseline": "docs/benchmarks/2026-06-17-rust-indexing-core-phase-15f-production-like-vscode-baseline.raw.json",
    "lazyNormalizationAfter": "docs/benchmarks/2026-06-17-rust-indexing-core-phase-15f-lazy-normalization-vscode-after.raw.json"
  }
}
