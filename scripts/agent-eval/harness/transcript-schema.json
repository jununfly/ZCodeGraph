{
  "title": "BaselineTranscript",
  "description": "Provider-neutral evidence for one arm of an Agent Sufficiency Baseline. The harness never fills humanReview.",
  "version": "1.0",
  "type": "object",
  "required": [
    "schemaVersion", "runId", "arm", "corpus", "provider", "toolCalls",
    "toolCallCount", "readGrepFallbackDisplacement", "usage", "finalResponse",
    "transcriptPath", "sharedConfigFingerprint", "status", "humanReview"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string" },
    "arm": { "enum": ["with", "without"] },
    "corpus": {
      "type": "object",
      "required": ["id", "prompt"],
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "promptId": { "type": "string" },
        "snapshot": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["adapterId", "model"],
      "properties": {
        "adapterId": { "type": "string" },
        "model": { "type": "string", "description": "Resolved at run time; never hard-coded." },
        "requestedEffort": { "type": "string", "description": "Explicit shared execution setting; not evidence of runtime adoption." },
        "resolvedEffort": { "type": ["string", "null"], "description": "Runtime-read effort, or null when the provider transcript does not expose it." }
      }
    },
    "toolCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "callId": { "type": "string" },
          "arguments": {},
          "timestamp": { "type": "string" }
        }
      }
    },
    "toolCallCount": { "type": "integer", "minimum": 0 },
    "mcp": {
      "type": "object",
      "description": "Observed MCP handshake and tool adoption. Connection and advertisement do not imply tool calls.",
      "required": ["servers", "advertisedCodeGraphTools", "codeGraphToolCallCount"],
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        },
        "advertisedCodeGraphTools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "codeGraphToolCallCount": { "type": "integer", "minimum": 0 }
      }
    },
    "finalResponse": { "type": "string", "minLength": 1 },
    "transcriptPath": { "type": "string" },
    "readGrepFallbackDisplacement": {
      "type": ["object", "null"],
      "description": "Null means not measured; zero counts require an independently reviewed fallback classification.",
      "properties": {
        "read": { "type": "integer" },
        "grep": { "type": "integer" },
        "notes": { "type": "string" }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "promptTokens": { "type": "number" },
        "completionTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "credit": { "type": "number" }
      }
    },
    "humanReview": {
      "type": ["object", "null"],
      "description": "Human-owned. The harness writes null; a named reviewer fills reviewer, answerSufficiencyNotes and finalClassification.",
      "properties": {
        "reviewer": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "answerSufficiencyNotes": { "type": "string" },
        "finalClassification": {
          "enum": ["preserved", "improved", "regressed", "inconclusive", "needs-human-review"]
        }
      }
    },
    "sharedConfigFingerprint": { "type": "string" },
    "graphStats": {
      "type": ["object", "null"],
      "description": "Null means graph statistics were not measured; the empty object is not a measurement."
    },
    "fallbackTaxonomy": {
      "type": ["object", "null"],
      "description": "Null means no reviewed fallback taxonomy is available; the empty object is not a measurement."
    },
    "status": { "enum": ["valid", "invalid"] },
    "invalidReason": { "type": ["string", "null"] }
  }
}
